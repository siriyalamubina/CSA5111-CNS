
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[100];
    int key[100], i, n, j = 0, p, c;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter number of keys: ");
    scanf("%d", &n);

    printf("Enter key values:\n");

    for(i = 0; i < n; i++)
        scanf("%d", &key[i]);

    printf("Encrypted text: ");

    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)text[i]))
        {
            if(j >= n)
            {
                printf("\nNot enough key values\n");
                return 0;
            }

            p = toupper(text[i]) - 'A';
            c = (p + key[j]) % 26;

            printf("%c", c + 'A');
            j++;
        }
    }

    printf("\n");
    return 0;
}
