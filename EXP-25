
#include <stdio.h>

int gcd(int a, int b)
{
    while(b != 0)
    {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main()
{
    int n, m, g;

    printf("Enter RSA modulus n: ");
    scanf("%d", &n);

    printf("Enter plaintext block m: ");
    scanf("%d", &m);

    g = gcd(m, n);

    printf("GCD = %d\n", g);

    if(g > 1 && g < n)
    {
        printf("Common factor found!\n");
        printf("First factor = %d\n", g);
        printf("Second factor = %d\n", n / g);
    }
    else
    {
        printf("No useful common factor found.\n");
    }

    return 0;
}
