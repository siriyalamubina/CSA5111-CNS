#include <stdio.h>
#include <ctype.h>
#include <string.h>
char m[5][5] = {
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};
void find(char ch, int *r, int *c)
{
    int i, j;
    if (ch == 'J') ch = 'I';
    for (i = 0; i < 5; i++)
        for (j = 0; j < 5; j++)
            if (m[i][j] == ch)
            {
                *r = i;
                *c = j;
                return;
            }
}
int main()
{
    char text[200], p[300], out[300], ch;
    int i, n = 0, k = 0, r1, c1, r2, c2;
    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);
    for (i = 0; text[i]; i++)
    {
        ch = toupper((unsigned char)text[i]);
        if (ch == 'J') ch = 'I';
        if (ch >= 'A' && ch <= 'Z')
            p[n++] = ch;
    }
    p[n] = '\0';
    for (i = 0; i < n; )
    {
        char a = p[i++];
        char b;
        if (i == n || p[i] == a)
            b = 'X';
        else
            b = p[i++];
        find(a, &r1, &c1);
        find(b, &r2, &c2);
        if (r1 == r2)
        {
            out[k++] = m[r1][(c1 + 1) % 5];
            out[k++] = m[r2][(c2 + 1) % 5];
        }
        else if (c1 == c2)
        {
            out[k++] = m[(r1 + 1) % 5][c1];
            out[k++] = m[(r2 + 1) % 5][c2];
        }
        else
        {
            out[k++] = m[r1][c2];
            out[k++] = m[r2][c1];
        }
    }
    out[k] = '\0';
    printf("Encrypted text: %s\n", out);
    return 0;
}
