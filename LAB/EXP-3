#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

void createMatrix(char key[])
{
    int used[26] = {0};
    int i, r = 0, c = 0;
    char ch;

    for (i = 0; key[i] != '\0'; i++)
    {
        ch = toupper(key[i]);

        if (ch == 'J')
            ch = 'I';

        if (ch >= 'A' && ch <= 'Z' && !used[ch - 'A'])
        {
            matrix[r][c++] = ch;
            used[ch - 'A'] = 1;

            if (c == 5)
            {
                c = 0;
                r++;
            }
        }
    }

    for (ch = 'A'; ch <= 'Z'; ch++)
    {
        if (ch == 'J')
            continue;

        if (!used[ch - 'A'])
        {
            matrix[r][c++] = ch;
            used[ch - 'A'] = 1;

            if (c == 5)
            {
                c = 0;
                r++;
            }
        }
    }
}

void findPosition(char ch, int *row, int *col)
{
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++)
    {
        for (j = 0; j < 5; j++)
        {
            if (matrix[i][j] == ch)
            {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

int main()
{
    char key[50], text[100], prepared[200], encrypted[200];
    int i, n = 0;
    int r1, c1, r2, c2;

    printf("Enter keyword: ");
    scanf("%s", key);

    printf("Enter plaintext: ");
    scanf("%s", text);

    createMatrix(key);

    printf("\nPlayfair Matrix:\n");
    for (i = 0; i < 5; i++)
    {
        printf("%c %c %c %c %c\n",
               matrix[i][0], matrix[i][1], matrix[i][2],
               matrix[i][3], matrix[i][4]);
    }

    /* Prepare plaintext */
    for (i = 0; text[i] != '\0'; i++)
    {
        char ch = toupper(text[i]);

        if (ch == 'J')
            ch = 'I';

        if (ch >= 'A' && ch <= 'Z')
            prepared[n++] = ch;
    }

    prepared[n] = '\0';

    /* Insert X between repeated letters */
    for (i = 0; i < n - 1; i += 2)
    {
        if (prepared[i] == prepared[i + 1])
        {
            for (int j = n; j > i + 1; j--)
                prepared[j] = prepared[j - 1];

            prepared[i + 1] = 'X';
            n++;
        }
    }

    if (n % 2 != 0)
        prepared[n++] = 'X';

    prepared[n] = '\0';

    /* Encryption */
    int pos = 0;

    for (i = 0; i < n; i += 2)
    {
        findPosition(prepared[i], &r1, &c1);
        findPosition(prepared[i + 1], &r2, &c2);

        if (r1 == r2)
        {
            encrypted[pos++] = matrix[r1][(c1 + 1) % 5];
            encrypted[pos++] = matrix[r2][(c2 + 1) % 5];
        }
        else if (c1 == c2)
        {
            encrypted[pos++] = matrix[(r1 + 1) % 5][c1];
            encrypted[pos++] = matrix[(r2 + 1) % 5][c2];
        }
        else
        {
            encrypted[pos++] = matrix[r1][c2];
            encrypted[pos++] = matrix[r2][c1];
        }
    }

    encrypted[pos] = '\0';

    printf("\nPrepared plaintext: %s", prepared);
    printf("\nEncrypted text: %s\n", encrypted);

    return 0;
}
