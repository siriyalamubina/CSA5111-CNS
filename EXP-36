
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int gcd(int a, int b)
{
    while(b != 0)
    {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main()
{
    char text[100];
    int a, b, i, p, c;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter a and b: ");
    scanf("%d%d", &a, &b);

    a = (a % 26 + 26) % 26;
    b = (b % 26 + 26) % 26;

    if(gcd(a, 26) != 1)
    {
        printf("Invalid a value\n");
        return 0;
    }

    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)text[i]))
        {
            p = toupper(text[i]) - 'A';
            c = (a * p + b) % 26;
            text[i] = c + 'A';
        }
    }

    printf("Encrypted text: %s", text);

    return 0;
}
