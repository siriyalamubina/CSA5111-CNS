#include <stdio.h>
#include <string.h>
#include <ctype.h>
int main() {
    char text[100];
    char key[] = "HELLO";
    char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    char cipher[27] = "";
    char used[26] = {0};
    int i, j, index = 0;
    for (i = 0; key[i] != '\0'; i++) {
        char ch = toupper(key[i]);

        if (!used[ch - 'A']) {
            cipher[index++] = ch;
            used[ch - 'A'] = 1;
        }
    }
    for (i = 0; i < 26; i++) {
        if (!used[i]) {
            cipher[index++] = alphabet[i];
        }
    }
    cipher[26] = '\0';
    printf("Key: %s\n", key);
    printf("Cipher Alphabet: %s\n", cipher);
    printf("Enter the text: ");
    fgets(text, sizeof(text), stdin);
    for (i = 0; text[i] != '\0'; i++) {
        if (text[i] >= 'A' && text[i] <= 'Z')
            text[i] = cipher[text[i] - 'A'];

        else if (text[i] >= 'a' && text[i] <= 'z')
            text[i] = tolower(cipher[text[i] - 'a']);
    }
    printf("Encrypted text: %s", text);
    return 0;
}
