
#include <stdio.h>
#include <string.h>

int main()
{
    char text[200];
    int block, n, pad, i;

    printf("Enter binary plaintext: ");
    scanf("%199s", text);

    printf("Enter block size: ");
    scanf("%d", &block);

    if(block <= 0)
    {
        printf("Invalid block size\n");
        return 0;
    }

    n = strlen(text);

    if(strspn(text, "01") != n)
    {
        printf("Enter binary data only\n");
        return 0;
    }

    pad = block - (n % block);

    text[n++] = '1';

    for(i = 1; i < pad; i++)
        text[n++] = '0';

    text[n] = '\0';

    printf("Padded plaintext: %s\n", text);
    printf("Total bits: %d\n", n);

    return 0;
}
