
#include <stdio.h>
#include <openssl/des.h>

int main()
{
    DES_cblock key1, key2, key3, iv;
    DES_key_schedule ks1, ks2, ks3;
    unsigned char p[8], c[8], d[8];
    int i;

    printf("Enter 8-character plaintext: ");
    scanf("%8s", p);

    printf("Enter 24-character key: ");
    char key[25];
    scanf("%24s", key);

    printf("Enter 8-character IV: ");
    scanf("%8s", iv);

    for(i=0;i<8;i++)
    {
        key1[i]=key[i];
        key2[i]=key[i+8];
        key3[i]=key[i+16];
    }

    DES_set_key_unchecked(&key1,&ks1);
    DES_set_key_unchecked(&key2,&ks2);
    DES_set_key_unchecked(&key3,&ks3);

    DES_ede3_cbc_encrypt(p,c,8,
        &ks1,&ks2,&ks3,&iv,DES_ENCRYPT);

    printf("Encrypted text: ");
    for(i=0;i<8;i++)
        printf("%02X",c[i]);

    iv[0]='1'; iv[1]='2'; iv[2]='3'; iv[3]='4';
    iv[4]='5'; iv[5]='6'; iv[6]='7'; iv[7]='8';

    // Restore original IV for decryption
    char original_iv[]="12345678";

    for(i=0;i<8;i++)
        iv[i]=original_iv[i];

    DES_ede3_cbc_encrypt(c,d,8,
        &ks1,&ks2,&ks3,&iv,DES_DECRYPT);

    printf("\nDecrypted text: ");
    for(i=0;i<8;i++)
        printf("%c",d[i]);

    printf("\n");
    return 0;
}
