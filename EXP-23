
#include <stdio.h>

int main()
{
    int p[100], c[100], d[100];
    int n, a, b, i, counter = 0;
    int inv = -1, stream;

    printf("Enter number of bytes: ");
    scanf("%d", &n);

    printf("Enter plaintext bytes:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &p[i]);

    printf("Enter a and b: ");
    scanf("%d%d", &a, &b);

    if(a % 2 == 0)
    {
        printf("a must be odd\n");
        return 0;
    }

    for(i = 1; i < 256; i++)
        if((a * i) % 256 == 1)
            inv = i;

    for(i = 0; i < n; i++)
    {
        stream = (a * counter + b) % 256;
        c[i] = p[i] ^ stream;
        counter++;
    }

    printf("Encrypted bytes: ");
    for(i = 0; i < n; i++)
        printf("%d ", c[i]);

    counter = 0;

    for(i = 0; i < n; i++)
    {
        stream = (a * counter + b) % 256;
        d[i] = c[i] ^ stream;
        counter++;
    }

    printf("\nDecrypted bytes: ");
    for(i = 0; i < n; i++)
        printf("%d ", d[i]);

    printf("\n");
    return 0;
}
