
#include <stdio.h>
#include <string.h>

int main()
{
    char text[500], result[500];
    int i, k;

    printf("Enter ciphertext: ");
    fgets(text,sizeof(text),stdin);

    printf("\nPossible plaintexts:\n");

    for(k=0;k<26;k++)
    {
        for(i=0;text[i]!='\0';i++)
        {
            if(text[i]>='A' && text[i]<='Z')
                result[i]=(text[i]-'A'-k+26)%26+'A';
            else if(text[i]>='a' && text[i]<='z')
                result[i]=(text[i]-'a'-k+26)%26+'a';
            else
                result[i]=text[i];
        }

        result[i]='\0';

        printf("Key %d: %s",k,result);
    }

    return 0;
}
