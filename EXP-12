
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[200], cipher[200];
    int a, b, c, d, x, y, i, n;
    
    printf("Enter plaintext: ");
    scanf("%199s", text);

    n = strlen(text);

    if(n % 2 != 0)
        text[n++] = 'X';

    text[n] = '\0';

    for(i = 0; i < n; i += 2)
    {
        x = toupper(text[i]) - 'A';
        y = toupper(text[i+1]) - 'A';

        a = (9*x + 4*y) % 26;
        b = (5*x + 7*y) % 26;

        cipher[i] = a + 'A';
        cipher[i+1] = b + 'A';
    }

    cipher[n] = '\0';

    printf("Encrypted text: %s\n", cipher);

    // Inverse matrix modulo 26:
    // determinant = 43 = 17 mod 26
    // inverse of 17 = 23
    // Inverse matrix = [3 12; 15 25]

    for(i = 0; i < n; i += 2)
    {
        x = cipher[i] - 'A';
        y = cipher[i+1] - 'A';

        a = (3*x + 12*y) % 26;
        b = (15*x + 25*y) % 26;

        printf("%c%c", a + 'A', b + 'A');
    }

    printf("\n");
    return 0;
}
