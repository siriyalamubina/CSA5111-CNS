
#include <stdio.h>

int inverse(int a)
{
    int i;
    for(i = 1; i < 256; i++)
        if((a * i) % 256 == 1)
            return i;
    return -1;
}

int main()
{
    int p[100], c[100], d[100];
    int n, a, b, iv, inv, i, x;

    printf("Enter number of bytes: ");
    scanf("%d", &n);

    printf("Enter plaintext bytes:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &p[i]);

    printf("Enter a, b and IV: ");
    scanf("%d%d%d", &a, &b, &iv);

    if(a % 2 == 0)
    {
        printf("Invalid a. Enter an odd number.\n");
        return 0;
    }

    inv = inverse(a);

    for(i = 0; i < n; i++)
    {
        x = (i == 0) ? iv : c[i-1];
        c[i] = (a * (p[i] ^ x) + b) % 256;
    }

    printf("Encrypted bytes: ");
    for(i = 0; i < n; i++)
        printf("%d ", c[i]);

    for(i = 0; i < n; i++)
    {
        x = (inv * ((c[i] - b + 256) % 256)) % 256;
        d[i] = x ^ ((i == 0) ? iv : c[i-1]);
    }

    printf("\nDecrypted bytes: ");
    for(i = 0; i < n; i++)
        printf("%d ", d[i]);

    printf("\n");
    return 0;
}
