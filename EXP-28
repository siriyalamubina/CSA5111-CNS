
#include <stdio.h>

long long power(long long a, long long b, long long q)
{
    long long result = 1;

    a %= q;

    while(b > 0)
    {
        if(b % 2 == 1)
            result = (result * a) % q;

        a = (a * a) % q;
        b /= 2;
    }

    return result;
}

int main()
{
    long long q, a, x, y;
    long long A, B, key1, key2;

    printf("Enter prime number q: ");
    scanf("%lld", &q);

    printf("Enter generator a: ");
    scanf("%lld", &a);

    printf("Enter Alice private key: ");
    scanf("%lld", &x);

    printf("Enter Bob private key: ");
    scanf("%lld", &y);

    A = power(a, x, q);
    B = power(a, y, q);

    key1 = power(B, x, q);
    key2 = power(A, y, q);

    printf("Alice public key: %lld\n", A);
    printf("Bob public key: %lld\n", B);

    printf("Alice shared key: %lld\n", key1);
    printf("Bob shared key: %lld\n", key2);

    return 0;
}
